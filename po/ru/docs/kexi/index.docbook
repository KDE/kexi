<abstract>
  <para
>&kexi; — приложение для создания баз данных и управления данными из офисного пакета &calligra;. </para>
</abstract>

<!-- Keywords -->
<keywordset>
  <keyword
>KDE</keyword>
  <keyword
>Calligra</keyword>
  <keyword
>Kexi</keyword>
  <keyword
>база данных</keyword>
</keywordset>
</bookinfo>
